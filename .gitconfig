[user]
	name = Alexey Mileev
	email = alemileev@gmail.com
[core]
	pager = less
  sshCommand = ssh -i ~/.ssh/id_rsa -o IdentitiesOnly=yes
[init]
	defaultBranch = main
[rerere]
	enabled = true
[credential]
	helper = cache --timeout=3600
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

[includeIf "gitdir:~/workspace/dm/"]
  path = ~/.gitconfig-dm

[maintenance]
	repo = /Users/rozag/workspace/twain
	repo = /Users/rozag/workspace/upp
	repo = /Users/rozag/workspace/real-talk
	repo = /Users/rozag/workspace/cabasi
